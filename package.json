{
    "name": "backend_one",
    "version": "1.0.0",
    "description": "Project on managing projects on a single platform",
    "main": "src/index.js",
    "directories": {
        "test": "test"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "test": "node scripts/verify.mjs",
        "test:unit": "node --test src/utils/verification-link.test.js",
        "verify": "node scripts/verify.mjs",
        "seed": "node scripts/seed-demo.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "boot-check": "node --input-type=module -e \"import('./src/app.js').then(() => console.log('boot ok'))\""
    },
    "keywords": [
        "management",
        "project"
    ],
    "author": "Akshat Chaurasia",
    "license": "ISC",
    "devDependencies": {
        "prettier": "3.8.4"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mailgen": "^2.0.34",
        "mongoose": "^9.7.2",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.1",
        "nodemon": "^3.1.14"
    }
}
