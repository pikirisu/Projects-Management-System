# Copy to .env.local for local development. Vite exposes only VITE_* variables
# to client code, and inlines them at build time.

# Base URL of the API, including /api/v1.
# Local:      http://localhost:8000/api/v1   (match PORT in the backend .env)
# Production: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Optional. With both set, the sign-in page offers "Try the demo". Use the
# accounts scripts/seed-demo.mjs creates, and list them in the API's DEMO_EMAILS
# so visitors cannot change their password or profile.
# VITE_DEMO_EMAIL=demo.owner@example.com
# VITE_DEMO_PASSWORD=DemoPass123!
