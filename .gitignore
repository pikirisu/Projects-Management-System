# dependencies
node_modules

# environment — never commit real secrets. .env.example is the committed template.
.env
.env.local
.env.*.local

# local scratch: reference copy and PRD, not active test specs.
# Leading slashes anchor these to the repo root -- a bare `test` matches at every
# depth and would silently swallow frontend/src/test/, whose helpers CI needs.
/test/
/test.md

# personal files that must never reach a public repo
*.pdf

# local-only working notes (interview prep, resume evidence)
docs/

# build output
dist
build
.vite

# editor / OS / local agent config
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# misc
CHANGELOG.md
*.log
