# dependencies
node_modules

# environment — never commit real secrets. .env.example is the committed template.
.env
.env.local
.env.*.local

# local scratch: reference copy and PRD, not active test specs.
# Leading slashes anchor these to the repo root -- a bare `test` matches at every
# depth and would silently swallow frontend/src/test/, whose helpers CI needs.
/test/
/test.md

# personal files that must never reach a public repo
*.pdf

# local-only working notes (interview prep, resume evidence)
/docs/

# Local-disk uploads. Everything under here is user content -- a task
# attachment or a profile photo -- written at runtime by src/utils/storage.js
# when Cloudinary is not configured. The directory is kept so the server has
# somewhere to write; its contents are never committed. Without this, one
# `git add -A` publishes whatever anyone has uploaded.
/public/images/*
!/public/images/.gitkeep

# build output
dist
build
.vite

# editor / OS / local agent config
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# misc
CHANGELOG.md
*.log
