# Copy to .env and fill in. Every key below is read somewhere in src/ or scripts/.
# Verify with: grep -rhoE "process\.env\.[A-Z_0-9]+" src/ scripts/ | sort -u

# ---- Required ----------------------------------------------------------------

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/backend_one
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use DIFFERENT values for access and refresh, and never reuse local secrets in production.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Base URL of THIS API. Used to build task attachment links and by scripts/verify.mjs.
SERVER_URL=http://localhost:3000

# Frontend URL the password-reset email links to.
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# ---- Server ------------------------------------------------------------------

PORT=3000

# Comma-separated allowed origins. Leaving this unset or "*" reflects the
# caller's origin, which combined with credentials:true lets ANY site send
# authenticated requests. The server logs a warning at startup when it is "*".
# Set an explicit origin before deploying.
CORS_ORIGIN=http://localhost:5173

# Set to "production" on a deployed server: auth cookies then require HTTPS.
NODE_ENV=development

# Number of proxy hops to trust. Required behind a reverse proxy (Render, nginx)
# so rate limiting sees the real client IP instead of the proxy's. Leave UNSET
# locally -- trusting a proxy that isn't there lets a client spoof its own IP
# via X-Forwarded-For and walk straight past the rate limiter.
# TRUST_PROXY=1

# ---- Email (verification + password reset) -----------------------------------
# Mailtrap-style SMTP. mail.js logs and swallows send failures rather than
# throwing, so registration still returns 200 if these are wrong -- check the
# server console when debugging delivery.

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# ---- Optional tuning (defaults shown) ----------------------------------------

# "strict" (default), "lax", or "none". Use "none" only for a cross-site
# frontend; it forces secure:true regardless of NODE_ENV.
COOKIE_SAMESITE=strict

# When "true", login rejects users whose email is unverified with a 403.
REQUIRE_EMAIL_VERIFICATION=false

# Set to "false" to disable all rate limiting. Needed to run scripts/verify.mjs
# repeatedly -- it makes several auth calls per run.
RATE_LIMIT_ENABLED=true

# Global budget per IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# Auth endpoints. Counts FAILED attempts only; successful logins are skipped.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
