# Copy to .env and fill in. Every key here is read somewhere in src/ or scripts/.

# ---- Required ----------------------------------------------------------------

# Local: mongodb://127.0.0.1:27017/project_camp
MONGO_URI=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use different values for the two, and never reuse local ones in production.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# This API's own URL: locally stored files are linked from it.
SERVER_URL=http://localhost:8000

# Client routes the emailed links open; the token is appended as a path segment.
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:5173/verify-email

# ---- Server ------------------------------------------------------------------

PORT=8000

# The client's origin(s), comma-separated. Unset or "*" reflects any origin,
# which with credentials lets any site call the API; the server warns at start.
CORS_ORIGIN=http://localhost:5173

# "production" makes auth cookies HTTPS-only.
NODE_ENV=development

# Proxy hops to trust (e.g. 1 behind Render or nginx), so rate limiting sees the
# client's IP. Leave unset locally: trusting a proxy that is not there lets a
# client spoof its IP and walk past the limiter.
# TRUST_PROXY=1

# The client's URL, linked from email footers.
APP_URL=http://localhost:5173

# ---- Email -------------------------------------------------------------------
# Failures are logged, never thrown, so a wrong setting here does not fail a
# request: check the server log when emails do not arrive.

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
MAILTRAP_SENDEREMAIL=no-reply@projectcamp.dev

# ---- File storage ------------------------------------------------------------
# All three set: uploads go to Cloudinary. Any missing: they go to public/,
# which is right locally and in CI, and wrong on a host with an ephemeral disk.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional tuning (defaults shown) ----------------------------------------

# "strict", "lax", or "none" (cross-site clients only; forces secure cookies).
COOKIE_SAMESITE=strict

# "true" refuses sign-in to unverified accounts with a 403.
REQUIRE_EMAIL_VERIFICATION=false

# "false" disables rate limiting, which npm run verify needs on the server.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# Counts failed attempts only.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
